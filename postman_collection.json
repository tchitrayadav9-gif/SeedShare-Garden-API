    {
      "name": "3. Leases (SQL JOIN Endpoint - Tasks 1 & 3)",
      "item": [
        {
          "name": "GET Leases with Gardener Name & Plot Name (JOIN Endpoint)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leases",
              "host": ["{{baseUrl}}"],
              "path": ["leases"]
            },
            "description": "Requirement: One join endpoint: leases with the gardener name and the plot name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Includes joined gardener name and plot name\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    if (json.length > 0) {",
                  "        var first = json[0];",
                  "        pm.expect(first).to.have.property('gardener_name');",
                  "        pm.expect(first).to.have.property('plot_name');",
                  "        pm.expect(first).to.have.property('plot_soil');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Single Lease with JOIN details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leases/1",
              "host": ["{{baseUrl}}"],
              "path": ["leases", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Lease has gardener and plot names\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('gardener_name');",
                  "    pm.expect(json).to.have.property('plot_name');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Lease",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gardener_id\": 3,\n  \"plot_id\": 3,\n  \"start_date\": \"2026-06-01\",\n  \"end_date\": \"2026-11-30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leases",
              "host": ["{{baseUrl}}"],
              "path": ["leases"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Lease joins gardener and plot details on response\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('gardener_name');",
                  "    pm.expect(json).to.have.property('plot_name');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Lease Conflict (Two Gardeners Same Plot Prevention)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gardener_id\": 2,\n  \"plot_id\": 1,\n  \"start_date\": \"2026-07-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leases",
              "host": ["{{baseUrl}}"],
              "path": ["leases"]
            },
            "description": "Fixes scenario: 'Two gardeners were promised the same plot'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request on duplicate active lease\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Conflict explanation in message\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include('Conflict');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
